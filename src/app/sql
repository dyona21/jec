-- ==============================================================================
-- 1. CRIAÇÃO DAS TABELAS BASE (Não dependem de outras tabelas)
-- ==============================================================================

CREATE TABLE pessoa (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(11) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE, 
    senha VARCHAR(255),        
    data_nascimento DATE NOT NULL,
    adm BOOLEAN 
);

CREATE TABLE plano_socio (
    id SERIAL PRIMARY KEY,
    nome_plano VARCHAR(50) NOT NULL,
    valor NUMERIC(10, 2) NOT NULL, 
    vantagens TEXT,                 -- Antiga coluna 'beneficios'
    beneficio TEXT,                 -- Coluna nova adicionada
    forma_pagamento VARCHAR(255)    -- Coluna nova adicionada
);

CREATE TABLE competicao (
    id SERIAL PRIMARY KEY,
    nome_competicao VARCHAR(100) NOT NULL,
    ano INTEGER NOT NULL,
    foto VARCHAR(255), 
    descricao TEXT
);

-- ==============================================================================
-- 2. CRIAÇÃO DAS TABELAS ESPECIALIZADAS (Dependem de Pessoa ou Plano)
-- ==============================================================================

CREATE TABLE atleta (
    id_pessoa INTEGER PRIMARY KEY, 
    posicao VARCHAR(50) NOT NULL,
    foto VARCHAR(255), 
    partidas INTEGER DEFAULT 0,
    CONSTRAINT fk_atleta_pessoa FOREIGN KEY (id_pessoa) REFERENCES pessoa (id) ON DELETE CASCADE
);

CREATE TABLE socio (
    id_pessoa INTEGER PRIMARY KEY, 
    id_plano INTEGER NOT NULL,
    CONSTRAINT fk_socio_pessoa FOREIGN KEY (id_pessoa) REFERENCES pessoa (id) ON DELETE CASCADE,
    CONSTRAINT fk_socio_plano FOREIGN KEY (id_plano) REFERENCES plano_socio (id) ON DELETE RESTRICT
);

-- ==============================================================================
-- 3. CRIAÇÃO DA TABELA PARTIDA (Depende de Competição)
-- ==============================================================================

CREATE TABLE partida (
    id SERIAL PRIMARY KEY,
    adversario VARCHAR(100) NOT NULL,
    data_hora TIMESTAMP NOT NULL, 
    local VARCHAR(150) NOT NULL,
    gols_jec INTEGER DEFAULT 0,
    gols_adversa INTEGER DEFAULT 0,
    descricao TEXT,
    link_dos_lances VARCHAR(255), -- Coluna nova adicionada
    id_competicao INTEGER NOT NULL,
    CONSTRAINT fk_partida_competicao FOREIGN KEY (id_competicao) REFERENCES competicao (id) ON DELETE CASCADE
);

